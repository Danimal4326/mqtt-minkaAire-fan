[Unit]
Description=Starts the MinkaAire fan to mqtt service
After=multi-user.target

[Service]
Type=idle
ExecStart=node /home/danc/mqtt-minkaAire-fan/index.js --mqtt MQTT_HOST --user MQTT_USER --password MQTT_PASSWORD  --exec /home/danc/bin/ --mqttTopicPrefix minkaAire/
Restart=always

[Install]
WantedBy=multi-user.target

